# Development: point this at your self-hosted FreeLLMAPI router.
FREELLMAPI_URL=http://127.0.0.1:8080
FREELLMAPI_API_KEY=freellmapi-your-unified-key
FREELLMAPI_MODEL=auto

# Optional for local development when frontend/backend are on different origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
